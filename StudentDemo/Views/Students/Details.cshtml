@model Student
@{
    ViewData["Title"] = "Chi tiết: " + Model.FullName;
}

<h1 class="mb-3">Chi tiết sinh viên</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Họ tên</dt>
    <dd class="col-sm-10">@Model.FullName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Tuổi</dt>
    <dd class="col-sm-10">@Model.Age</dd>
</dl>

<div>
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
    <a class="btn btn-link" asp-action="Index">Quay lại danh sách</a>
</div>
