@model User
@{
    ViewData["Title"] = "Xóa người dùng";
}

<h1>Xóa người dùng</h1>

<p>Bạn có chắc muốn xóa người dùng này?</p>
<dl class="row">
    <dt class="col-sm-2">Id</dt><dd class="col-sm-10">@Model.Id</dd>
    <dt class="col-sm-2">Tên đăng nhập</dt><dd class="col-sm-10">@Model.Username</dd>
    <dt class="col-sm-2">Họ tên</dt><dd class="col-sm-10">@Model.FullName</dd>
</dl>

<form method="post" asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
